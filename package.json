{
  "name": "chat-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-chat cockpit for AI coding agents",
  "author": "Agent Desktop Suite",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:cockpit": "CHAT_HUB_COCKPIT=1 electron-vite dev",
    "dev:cockpit:hud": "CHAT_HUB_COCKPIT=1 CHAT_HUB_COCKPIT_VIBRANCY=hud electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:mac": "./packaging/build-app.sh",
    "dist:mac": "./packaging/build-app.sh --dmg",
    "pack:linux": "electron-vite build && electron-builder --linux dir",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "install:mac": "./packaging/install-app.sh",
    "uninstall:mac": "./packaging/uninstall-app.sh",
    "status:mac": "./packaging/app-status.sh",
    "generate:codex-protocol": "codex app-server generate-ts --out src/main/codex-protocol/generated",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "mermaid": "^11.16.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  }
}