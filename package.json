{
  "name": "chat-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-chat cockpit for AI coding agents",
  "author": "Agent Desktop Suite",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:mac": "./packaging/build-app.sh",
    "dist:mac": "./packaging/build-app.sh --dmg",
    "install:mac": "./packaging/install-app.sh",
    "uninstall:mac": "./packaging/uninstall-app.sh",
    "status:mac": "./packaging/app-status.sh",
    "generate:codex-protocol": "codex app-server generate-ts --out src/main/codex-protocol/generated",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  }
}
